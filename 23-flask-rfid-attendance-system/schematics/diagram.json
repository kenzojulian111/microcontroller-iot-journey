{
  "version": 1,
  "author": "Kenzo Julian — IoT Lab Track III",
  "editor": "wokwi",
  "parts": [
    {
      "type": "wokwi-esp32-devkit-v1",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "board-ssd1306",
      "id": "oled1",
      "top": -115,
      "left": 180,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "wokwi-relay-module",
      "id": "relay1",
      "top": 30,
      "left": 240,
      "attrs": {}
    },
    {
      "type": "wokwi-buzzer",
      "id": "bz1",
      "top": 140,
      "left": 210,
      "attrs": { "volume": "0.1" }
    },
    {
      "type": "wokwi-led",
      "id": "ledGranted",
      "top": -60,
      "left": -130,
      "attrs": { "color": "green", "label": "GRANTED" }
    },
    {
      "type": "wokwi-led",
      "id": "ledDenied",
      "top": 0,
      "left": -130,
      "attrs": { "color": "red", "label": "DENIED" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": -30,
      "left": -85,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r2",
      "top": 30,
      "left": -85,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btnValid",
      "top": 110,
      "left": -160,
      "attrs": { "color": "green", "label": "Tap Valid RFID" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btnRogue",
      "top": 185,
      "left": -160,
      "attrs": { "color": "red", "label": "Tap Rogue RFID" }
    }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],
    [ "oled1:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "oled1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "oled1:SCL", "esp:D22", "yellow", [ "v0" ] ],
    [ "oled1:SDA", "esp:D21", "blue", [ "v0" ] ],
    [ "relay1:VCC", "esp:VIN", "red", [ "v0" ] ],
    [ "relay1:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "relay1:IN", "esp:D26", "orange", [ "v0" ] ],
    [ "bz1:1", "esp:GND.1", "black", [ "v0" ] ],
    [ "bz1:2", "esp:D25", "purple", [ "v0" ] ],
    [ "esp:D32", "r1:1", "green", [ "v0" ] ],
    [ "r1:2", "ledGranted:A", "green", [ "v0" ] ],
    [ "ledGranted:C", "esp:GND.2", "black", [ "v0" ] ],
    [ "esp:D33", "r2:1", "red", [ "v0" ] ],
    [ "r2:2", "ledDenied:A", "red", [ "v0" ] ],
    [ "ledDenied:C", "esp:GND.2", "black", [ "v0" ] ],
    [ "btnValid:1.l", "esp:D14", "green", [ "v0" ] ],
    [ "btnValid:2.l", "esp:GND.2", "black", [ "v0" ] ],
    [ "btnRogue:1.l", "esp:D12", "red", [ "v0" ] ],
    [ "btnRogue:2.l", "esp:GND.2", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
