    ["btn_smps:2.r", "esp:GND.1", "black", ["v0"]],
    ["esp:2", "led_overload:A", "red", ["v0"]],
    ["led_overload:C", "r1:1", "black", ["v0"]],
    ["r1:2", "esp:GND.2", "black", ["v0"]]
